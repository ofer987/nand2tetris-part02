class Multiplication {
  static int powers_of_two;

  function void init() {
    let powers_of_two = Array.new(16);

    let powers_of_two[0] = 1;
    let powers_of_two[1] = 2;
    let powers_of_two[2] = 4;
    let powers_of_two[3] = 8;
    let powers_of_two[4] = 16;
    let powers_of_two[5] = 32;
    let powers_of_two[6] = 64;
    let powers_of_two[7] = 128;
    let powers_of_two[8] = 256;
    let powers_of_two[9] = 512;
    let powers_of_two[10] = 1024;
    let powers_of_two[11] = 2048;
    let powers_of_two[12] = 4096;
    let powers_of_two[13] = 8192;
    let powers_of_two[14] = 16384;
    let powers_of_two[15] = 16384 + 16384;

    return;
  }

  function int multiply(int x, int y) {
    // TODO: validate that x and y are positive numbers
    var int shiftedX, j, sum;
    var int value_of_power_of_two;
    var boolean isTrue;

    let shiftedX = x;
    let sum = 0;
    let j = 0;

    while (j < 16) {
      let value_of_power_of_two = Multiplication.power_of_two(j);

      let isTrue = Multiplication.is_true(y, value_of_power_of_two);
      if (isTrue) {
        let sum = sum + shiftedX;
      }

      let shiftedX = shiftedX + shiftedX;
      let j = j + 1;
    }

    return sum;
  }

  function int power_of_two(int index) {
    var int result;
    var boolean isInvalid;
    var boolean leftOperand;
    var boolean rightOperand;

    let leftOperand = index > 15;
    let rightOperand = index < 0;

    let isInvalid = leftOperand | rightOperand;
    if (isInvalid) {
      return 0;
    }

    let result = powers_of_two[index];
    return result;
  }

  function int add(int x, int y) {
    var int result;

    let result = x + y;
    return result;
  }

  function boolean is_negative(int x) {
    var int value_of_power_of_two;
    var int result;
    var boolean isValid;

    let value_of_power_of_two = Multiplication.power_of_two(15);

    let result = Multiplication.bitwise_and(x, value_of_power_of_two);

    let isValid = result > 0;
    if (isValid) {
      return true;
    }

    return false;
  }

  function int absolute_value(int x, int y) {
    var int result;
    var boolean isValid;

    let result = x;

    let isValid = Multiplication.is_negative(x);
    if (isValid) {
      let result = ~x;
    }

    return result;
  }

  function boolean result_is_positive(int x, int y) {
    // XOR: Exclusive OR operation
    var boolean result;

    // let result = (Multiplication.is_negative(x) & Multiplication.is_negative(y)) | (Multiplication.is_negative(~x) & Multiplication.is_negative(~y));

    // return result;

    return true;
  }

  function boolean is_true(int x, int index) {
    var int value_of_power_of_two;
    var int result;
    var boolean isInvalid;
    var boolean leftOperand;
    var boolean rightOperand;
    var boolean isValid;

    let leftOperand = index > 15;
    let rightOperand = index < 0;

    let isInvalid = leftOperand | rightOperand;
    if (isInvalid) {
      return false;
    }

    let value_of_power_of_two = Multiplication.power_of_two(index);

    let result = Multiplication.bitwise_and(x, value_of_power_of_two);

    let isValid = result > 0;
    if (isValid) {
      return false;
    }

    return true;
  }

  function int bitwise_and(int x, int y) {
    // TODO emit VM_CODE
    return 2;
  }
}
