/** Initializes a new Square game and starts running it. */
class SquareGame {
    static int i;
    field int coolIndex;

    method int run(int index) {
      return index;
    }

    method void dispose() {
      return;
    }

    constructor SquareGame new() {
      return this;
    }
}
