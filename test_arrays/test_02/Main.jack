    var int result;                  // stores test results
    var Array a;
    var Hannukah menorah;

    let menorah = Hannukah.new(2);
    let result = 0;

    let a = Array.new(8);
    // let a[0] = 2;
    do Main.setValue(a);
    let a[1] = 3;
    let a[2] = 4;
    let a[3] = 5;

    let result = menorah.count(a);

    do a.dispose();

    return;
  }

  function void setValue(Array a) {
    let a[0] = 2;

    return;
  }
}
